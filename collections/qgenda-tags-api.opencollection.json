{
  "opencollection": "1.0.0",
  "info": {
    "name": "QGenda REST Company Tags API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qgenda.com/v2/v2/tags",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all tags the API user has access to, or can be filtered by company key.\nResponse Object: Array of TagDetailsByCompany"
        },
        {
          "info": {
            "name": "Tags",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qgenda.com/v2/v2/tags",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new tag in an existing tag category or creates a new tag in a new tag category\nResponse Object: TagDetailsByCompany"
        }
      ]
    }
  ],
  "bundled": true
}