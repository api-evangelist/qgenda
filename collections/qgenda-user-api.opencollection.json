{
  "opencollection": "1.0.0",
  "info": {
    "name": "QGenda REST Company User API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qgenda.com/v2/v2/user/",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all users who have access to companies\nResponse Object: Array of User"
        },
        {
          "info": {
            "name": "User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.qgenda.com/v2/v2/user/:Id",
            "params": [
              {
                "name": "Id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a Non-Scheduled User."
        },
        {
          "info": {
            "name": "NonScheduledUser",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qgenda.com/v2/v2/NonScheduledUser",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a Non-Scheduled User.\nResponse Object: NonScheduledUser"
        },
        {
          "info": {
            "name": "NonScheduledUser",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.qgenda.com/v2/v2/NonScheduledUser",
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a Non-Scheduled User.\nResponse Object: NonScheduledUser"
        },
        {
          "info": {
            "name": "NonScheduledUser/Location/Permissions",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.qgenda.com/v2/v2/NonScheduledUser/location/:locationId/permissions",
            "params": [
              {
                "name": "locationId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a non-scheduled user's permissions at a specified location.\nResponse Object: NonScheduledUserLocationPermissions"
        }
      ]
    }
  ],
  "bundled": true
}