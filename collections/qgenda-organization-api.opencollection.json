{
  "opencollection": "1.0.0",
  "info": {
    "name": "QGenda REST Company Organization API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.qgenda.com/v2/v2/organization",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of companies that belong to the given organization\nResponse Object: Array of Company"
        }
      ]
    }
  ],
  "bundled": true
}